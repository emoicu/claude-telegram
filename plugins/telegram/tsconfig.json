{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server.ts", "router.ts", "hooks/**/*.ts", "helpers/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
